@model Assignment1_EA.Models.Event

@{
    ViewData["Title"] = "Details";
}

<h1>Event Details</h1>

<!-- Hidden event ID used by SignalR -->
<input type="hidden" id="eventId" value="@Model.id" />

<div>
    <hr />

    <!-- Event Banner -->
    @if (!string.IsNullOrEmpty(Model.BannerUrl))
    {
        <div class="mb-3">
            <img src="@Model.BannerUrl"
                 alt="Event Banner"
                 style="max-width:500px;" />
        </div>
    }
    else
    {
        <p>No banner uploaded.</p>
    }

    <!-- Event Information -->
    <dl class="row">

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.title)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.title)
        </dd>


        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.date)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.date)
        </dd>


        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.location)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.location)
        </dd>


        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.description)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.description)
        </dd>

    </dl>
</div>


<hr />


<!-- ========================================================= -->
<!-- ATTENDEE SECTION                                         -->
<!-- ========================================================= -->

<h3>Attendees</h3>

<p>
    Number of Attendees:
    <strong id="attendeeCount">
        @(Model.Attendees?.Count ?? 0)
    </strong>
</p>


<!-- Organizer SignalR Notification -->
@if (User.IsInRole("Organizer"))
{
    <div id="organizerNotification"
         class="alert alert-info"
         style="display:none;">
    </div>
}


<!-- Attendee List -->
<div id="attendeeList">

    @if (Model.Attendees != null &&
         Model.Attendees.Any())
    {
        foreach (var attendee in Model.Attendees)
        {
            <p>
                @attendee.Name
            </p>
        }
    }
    else
    {
        <p id="noAttendeesMessage">
            No attendees registered yet.
        </p>
    }

</div>


<br />


<!-- ========================================================= -->
<!-- SELF REGISTRATION                                        -->
<!-- ========================================================= -->

@if (User.Identity?.IsAuthenticated == true)
{
    <form asp-controller="Attendees"
          asp-action="Register"
          method="post"
          class="mb-2">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="eventId"
               value="@Model.id" />

        <button type="submit"
                class="btn btn-primary">
            Register for Event
        </button>

    </form>


    <form asp-controller="Attendees"
          asp-action="Unregister"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="eventId"
               value="@Model.id" />

        <button type="submit"
                class="btn btn-danger">
            Unregister from Event
        </button>

    </form>
}
else
{
    <p>
        <a asp-area="Identity"
           asp-page="/Account/Login">
            Log in
        </a>
        to register for this event.
    </p>
}


<hr />


<!-- ========================================================= -->
<!-- NAVIGATION                                               -->
<!-- ========================================================= -->

<div>

    @if (User.IsInRole("Organizer"))
    {
        <a asp-controller="Attendees"
           asp-action="Index"
           asp-route-eventId="@Model.id">
            Manage Attendees
        </a>

        <span> | </span>

        <a asp-action="Edit"
           asp-route-id="@Model?.id">
            Edit
        </a>

        <span> | </span>
    }

    <a asp-action="Index">
        Back to List
    </a>

</div>


<!-- ========================================================= -->
<!-- SIGNALR                                                  -->
<!-- ========================================================= -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<script src="~/js/eventDetails.js"></script>