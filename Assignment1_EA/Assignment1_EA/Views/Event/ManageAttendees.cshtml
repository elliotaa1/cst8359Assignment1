@model Assignment1_EA.Models.Event
@{
    ViewData["Title"] = "Manage Attendees - " + ViewData["EventName"];
}
<!-- Display event name -->
<h2> Manage Attendees - @ViewData["EventName"]</h2>


<form asp-action="Signup" method="post">
    <!-- Hidden field to pass event ID -->
    <input type="hidden"
           name="eventId"
           value="@Model.id" />
    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    <!-- Name input -->
    <div>
        <label>Name</label>
        <input type="text"
               name="name"
               class="form-control" />
    </div>

    <br />
    <!-- Email input -->
    <div>
        <label>Email</label>
        <input type="email"
               name="email"
               class="form-control" />
    </div>

    <br />
    <!-- Submit button -->
    <button type="submit"
            class="btn btn-success">
        Sign Up
    </button>
    <!-- Back to Events button -->
    <a asp-controller="Event"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Events
    </a>

</form>

<hr />
<!-- Display attendee list -->
<h3>Attendees (@Model.Attendees.Count)</h3>
<!-- Error checker for attendees -->
@if (Model.Attendees == null || Model.Attendees.Count == 0)
{
    <p>No attendees registered.</p>
}
else
{
    <ul>
        <!-- Loop through attendees -->
        @foreach (var attendee in Model.Attendees)
        {
            <li>
                @attendee.Name
                (@attendee.Email)
            </li>
        }

    </ul>
}