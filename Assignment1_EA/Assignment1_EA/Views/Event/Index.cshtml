@model List<Assignment1_EA.Models.Event>



@{
    ViewData["Title"] = "Event Manager";
}


<!-- Table showing all events -->
<table class="table">

    <tr>
        <th>Title</th>
        <th>Date</th>
        <th>Location</th>
        <th></th>
    </tr>

    <!-- Loop through all events passed from controller -->
    @foreach (var ev in Model)
    {
        <tr>
            <td>@ev.title</td>
            <td>@ev.date.ToShortDateString()</td>
            <td>@ev.location</td>

            <td>
                <!-- Link to manage attendees for this event -->
                <a asp-action="ManageAttendees"
                   asp-route-id="@ev.id"
                   class="btn btn-primary">
                    Manage Attendees
                </a>
            </td>
        </tr>
    }

</table>